# ===== Environment Configuration =====
# Copy this file to .env.local and update values for your environment
# This file should be committed to version control.

# ===== API Configuration =====
# Base URL for API requests (mock data is used if not set)
VITE_API_BASE_URL=http://localhost:3000/api

# API request timeout in milliseconds
VITE_API_TIMEOUT=10000

# ===== Application Mode =====
# Set to true for development/debugging features
VITE_DEBUG_MODE=false

# ===== Feature Flags =====
# Enable/disable certain features
VITE_ENABLE_REAL_API=false
VITE_ENABLE_NOTIFICATIONS=true

# ===== Analytics & Monitoring =====
# Sentry DSN for error tracking (optional)
# VITE_SENTRY_DSN=https://your-key@sentry.io/project-id

# LogRocket token for session replay (optional)
# VITE_LOGROCKET_ID=your-app-id

# ===== Third-party Services =====
# Add external service configurations here
# Example: API keys for payment processors, analytics, etc.
